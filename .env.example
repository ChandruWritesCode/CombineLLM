COMBINELLM_APP_NAME=CombineLLM
COMBINELLM_ENVIRONMENT=development
# Used by Docker Compose for the host port.
COMBINELLM_PORT=8000

# Obtain a key in Google AI Studio; never commit it or paste it into chat.
COMBINELLM_GEMINI_API_KEY=
# Set a text model ID available to your account (without the models/ prefix).
COMBINELLM_GEMINI_MODEL=
COMBINELLM_PROVIDER_TIMEOUT_SECONDS=60
